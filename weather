    padding: 20px 14px 40px;
    min-height: 100vh;
  }
  .wrap { max-width: 860px; margin: 0 auto; }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  h1 { font-size: 1.5rem; margin: 0; }
  .subtitle { color: var(--sub); font-size: 0.88rem; margin-top: 4px; }
  button.refresh {
    font: inherit;
    font-size: 0.95rem;
    border: none;
    background: var(--accent);
    color: #fff;
    padding: 10px 18px;
    border-radius: 12px;
    cursor: pointer;
    transition: background 0.12s, transform 0.06s;
  }
  button.refresh:hover { background: var(--accent-hover); }
  button.refresh:active { transform: scale(0.96); }
  button.refresh:disabled { opacity: 0.6; cursor: default; }
  button.refresh:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

  .card {
    background: var(--panel);
    border-radius: 20px;
    padding: 18px;
    box-shadow: var(--shadow);
    margin-bottom: 16px;
  }
  .now {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .now-main { display: flex; align-items: center; gap: 14px; }
  .now-icon { font-size: 3.4rem; line-height: 1; }
  .now-temp { font-size: 2.8rem; font-weight: 600; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .now-desc { color: var(--sub); font-size: 0.95rem; margin-top: 2px; }
  .now-side { text-align: right; font-size: 0.95rem; line-height: 1.8; }
  .now-side b { font-variant-numeric: tabular-nums; }

  .section-title { font-size: 1.05rem; font-weight: 600; margin: 0 0 12px; }
  .chart-wrap { width: 100%; overflow-x: auto; }
  svg.chart { width: 100%; height: auto; min-width: 440px; display: block; }
