    --text: #1c1e21;
    --sub: #6b7280;
    --line: #e3e7ee;
    --hot: #ef6c2f;
    --cold: #2f7ef0;
    --rain: #3b82f6;
    --rain-bg: #dbe7ff;
    --err: #dc2626;
    --accent: #2563eb;
    --accent-hover: #1d4ed8;
    --shadow: 0 10px 28px rgba(0, 0, 0, 0.10);
  }
  @media (prefers-color-scheme: dark) {
    :root {
